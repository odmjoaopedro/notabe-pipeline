# Configuracoes do Banco de Dados (MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=notabe_db
DB_USER=notabe_user
DB_PASSWORD=senha_banco_de_dados

# Credenciais do NotaBe (Deve ser preenchido futuramente com dados reais)
NOTABE_LOGIN=login_email_ou_senha
NOTABE_PASSWORD=senha_notabe_aqui
NOTABE_API_TOKEN=token_pendente

#Modo de Execucao? "mock" (Simulacao local) ou "prod" (Sistema real)
APP_ENV=mock